<%- include('partials/header', { pageTitle: 'Home' }) %>

        <!-- Hero Section -->
        <section class="relative bg-gradient-to-b from-gray-900 to-black py-20 md:py-28 overflow-hidden">
            <div class="container mx-auto px-4 relative z-10">
                <div class="text-center max-w-5xl mx-auto">
                    <div class="mb-10 flex justify-center">
                        <img src="/images/afair-studio-logo-main.png" alt="A FAIR Studio" class="h-40 md:h-56">
                    </div>
                    <p class="text-lg md:text-xl text-brand-gold font-bold tracking-wider uppercase">
                        Tipping the Scales of Gameplay
                    </p>
                </div>
            </div>
        </section>

        <!-- Featured Game Section -->
        <% if (featuredGame) { %>
            <section class="py-12 md:py-16 bg-black">
                <div class="container mx-auto px-4">
                    <div class="max-w-6xl mx-auto">
                        <h2 class="text-2xl md:text-3xl text-white mb-8 font-bold">Featured game</h2>

                        <div class="grid md:grid-cols-5 gap-8 md:gap-12 items-center">
                            <a href="/games/<%= featuredGame.id %>"
                                class="md:col-span-3 block aspect-[5/4] bg-gray-900 overflow-hidden group">
                                <img src="<%= featuredGame.thumbnail %>" alt="<%= featuredGame.title %>"
                                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
                            </a>

                            <div class="md:col-span-2">
                                <h3 class="text-4xl font-bold text-white mb-2">
                                    <%= featuredGame.title %>
                                </h3>
                                <p class="text-brand-purple uppercase text-sm tracking-widest font-bold mb-6">
                                    <%= featuredGame.genre %>
                                </p>
                                <p class="text-gray-300 leading-relaxed mb-8">
                                    <%= featuredGame.description %>
                                </p>
                                <div class="flex flex-wrap gap-4">
                                    <% if (featuredGame.hasDemo) { %>
                                        <a href="/games/<%= featuredGame.id %>#demo"
                                            class="btn-primary inline-block uppercase tracking-wide">
                                            Play in Browser
                                        </a>
                                        <a href="/games/<%= featuredGame.id %>"
                                            class="btn-secondary inline-block uppercase tracking-wide">
                                            View Game
                                        </a>
                                    <% } else { %>
                                        <a href="/games/<%= featuredGame.id %>"
                                            class="btn-primary inline-block uppercase tracking-wide">
                                            View Game
                                        </a>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        <% } %>

        <!-- More Games Section -->
        <section class="py-12 md:py-16 bg-black">
            <div class="container mx-auto px-4">
                <div class="max-w-6xl mx-auto">
                    <div class="flex items-baseline justify-between mb-8">
                        <h2 class="text-2xl md:text-3xl text-white font-bold">More games</h2>
                        <a href="/games"
                            class="text-brand-gold hover:text-white transition-colors text-sm font-bold uppercase tracking-widest">
                            View all →
                        </a>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 md:gap-8">
                        <% recentGames.forEach(game=> { %>
                            <a href="/games/<%= game.id %>" class="group block">
                                <div class="aspect-[5/4] bg-gray-900 overflow-hidden mb-4">
                                    <img src="<%= game.thumbnail %>" alt="<%= game.title %>" loading="lazy"
                                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
                                </div>
                                <h3 class="text-xl font-bold text-white group-hover:text-brand-gold transition-colors">
                                    <%= game.title %>
                                </h3>
                                <p class="text-sm text-gray-400">
                                    <%= game.genre %>
                                </p>
                            </a>
                        <% }); %>
                    </div>
                </div>
            </div>
        </section>

        <!-- Awards Section -->
        <% if (awards.length> 0) { %>
            <section class="pt-12 md:pt-16 pb-20 md:pb-24 bg-black">
                <div class="container mx-auto px-4">
                    <div class="max-w-6xl mx-auto">
                        <div class="flex items-baseline justify-between mb-8">
                            <h2 class="text-2xl md:text-3xl text-white font-bold">Awards</h2>
                            <a href="/about"
                                class="text-brand-gold hover:text-white transition-colors text-sm font-bold uppercase tracking-widest">
                                About us →
                            </a>
                        </div>

                        <div class="flex flex-wrap justify-center md:justify-between gap-8">
                            <% awards.forEach(award=> { %>
                                <a href="/games/<%= award.game %>" class="flex flex-col items-center group">
                                    <%- include('partials/award-badge', { award }) %>
                                    <span
                                        class="mt-2 text-sm text-gray-400 group-hover:text-brand-gold transition-colors">
                                        <%= award.gameTitle %>
                                    </span>
                                </a>
                            <% }); %>
                        </div>
                    </div>
                </div>
            </section>
        <% } %>

        <%- include('partials/footer') %>
