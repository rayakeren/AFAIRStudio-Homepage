<%- include('../partials/header', { pageTitle: 'Games' }) %>

        <!-- Games Header -->
        <section class="pt-12 md:pt-16 pb-8 bg-black">
            <div class="container mx-auto px-4">
                <div class="max-w-6xl mx-auto">
                    <h1 class="text-4xl md:text-5xl font-bold text-white mb-3">Games</h1>
                    <p class="text-lg text-gray-400">Everything we've made so far.</p>
                </div>
            </div>
        </section>

        <!-- Games Grid -->
        <section class="pt-4 pb-20 md:pb-24 bg-black">
            <div class="container mx-auto px-4">
                <div class="max-w-6xl mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 md:gap-x-8 gap-y-12">
                    <% games.forEach(game=> { %>
                        <a href="/games/<%= game.id %>" class="group block">
                            <div class="aspect-[5/4] bg-gray-900 overflow-hidden mb-4">
                                <img src="<%= game.thumbnail %>" alt="<%= game.title %>" loading="lazy"
                                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
                            </div>
                            <h2 class="text-xl font-bold text-white group-hover:text-brand-gold transition-colors">
                                <%= game.title %>
                            </h2>
                            <p class="text-sm text-gray-400 mb-2">
                                <%= game.genre %>
                            </p>
                            <p class="text-sm text-gray-500 leading-relaxed">
                                <%= game.description %>
                            </p>
                        </a>
                    <% }); %>
                </div>
            </div>
        </section>

        <%- include('../partials/footer') %>
