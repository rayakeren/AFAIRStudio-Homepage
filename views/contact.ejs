<%- include('partials/header', { pageTitle: 'Contact Us' }) %>

        <!-- Contact Header -->
        <section class="pt-12 md:pt-16 pb-8 bg-black">
            <div class="container mx-auto px-4">
                <div class="max-w-6xl mx-auto">
                    <h1 class="text-4xl md:text-5xl font-bold text-white mb-3">Get in touch</h1>
                    <p class="text-lg text-gray-400">
                        Feedback, questions, or just want to say hi? We'd love to hear from you.
                    </p>
                </div>
            </div>
        </section>

        <!-- Contact Content -->
        <section class="pt-4 pb-20 md:pb-24 bg-black">
            <div class="container mx-auto px-4">
                <div class="max-w-6xl mx-auto grid md:grid-cols-5 gap-12 md:gap-16">

                    <!-- Contact Form -->
                    <div class="md:col-span-3">
                        <h2 class="text-2xl md:text-3xl font-bold text-white mb-8">Send a message</h2>
                        <form id="contact-form" class="space-y-6">
                            <div class="grid sm:grid-cols-2 gap-6">
                                <div>
                                    <label for="name" class="block text-sm text-gray-400 mb-2">Your name</label>
                                    <input type="text" id="name" name="name"
                                        class="w-full px-4 py-3 bg-gray-900 border border-gray-800 focus:border-brand-gold focus:outline-none text-white transition-colors"
                                        required>
                                </div>
                                <div>
                                    <label for="email" class="block text-sm text-gray-400 mb-2">Your email</label>
                                    <input type="email" id="email" name="email"
                                        class="w-full px-4 py-3 bg-gray-900 border border-gray-800 focus:border-brand-gold focus:outline-none text-white transition-colors"
                                        required>
                                </div>
                            </div>

                            <div>
                                <label for="subject" class="block text-sm text-gray-400 mb-2">Subject</label>
                                <input type="text" id="subject" name="subject"
                                    class="w-full px-4 py-3 bg-gray-900 border border-gray-800 focus:border-brand-gold focus:outline-none text-white transition-colors"
                                    required>
                            </div>

                            <div>
                                <label for="message" class="block text-sm text-gray-400 mb-2">Message</label>
                                <textarea id="message" name="message" rows="6"
                                    class="w-full px-4 py-3 bg-gray-900 border border-gray-800 focus:border-brand-gold focus:outline-none text-white transition-colors resize-none"
                                    required></textarea>
                            </div>

                            <button type="submit" class="btn-primary uppercase tracking-wide">
                                Send Message
                            </button>

                            <p class="text-sm text-gray-500">
                                This opens your email app with the message filled in. We typically respond within
                                24-48 hours.
                            </p>
                        </form>
                    </div>

                    <!-- Contact Info -->
                    <div class="md:col-span-2">
                        <h2 class="text-2xl md:text-3xl font-bold text-white mb-8">Studio info</h2>
                        <dl class="space-y-6 mb-10">
                            <div>
                                <dt class="text-sm text-gray-500 mb-1">Email</dt>
                                <dd>
                                    <a href="mailto:studioafair@gmail.com"
                                        class="text-white hover:text-brand-gold transition-colors">
                                        studioafair@gmail.com
                                    </a>
                                </dd>
                            </div>
                            <div>
                                <dt class="text-sm text-gray-500 mb-1">Location</dt>
                                <dd class="text-white">Surabaya, Indonesia</dd>
                            </div>
                            <div>
                                <dt class="text-sm text-gray-500 mb-1">Hours</dt>
                                <dd class="text-white">Monday - Friday, 9:00 AM - 5:00 PM (GMT+7)</dd>
                            </div>
                        </dl>

                        <h2 class="text-2xl md:text-3xl font-bold text-white mb-6">Follow us</h2>
                        <div class="space-y-4">
                            <a href="https://instagram.com/studioafair" target="_blank" rel="noopener"
                                class="flex items-center gap-3 text-gray-300 hover:text-brand-gold transition-colors">
                                <%- getIcon('instagram', 'w-5 h-5' ) %>
                                    <span>Instagram</span>
                            </a>
                            <a href="https://discord.gg/hWJfE8d8gv" target="_blank" rel="noopener"
                                class="flex items-center gap-3 text-gray-300 hover:text-brand-gold transition-colors">
                                <%- getIcon('discord', 'w-5 h-5' ) %>
                                    <span>Discord</span>
                            </a>
                            <a href="https://youtube.com/@afairstudio" target="_blank" rel="noopener"
                                class="flex items-center gap-3 text-gray-300 hover:text-brand-gold transition-colors">
                                <%- getIcon('youtube', 'w-5 h-5' ) %>
                                    <span>YouTube</span>
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <script>
            // No mail backend yet: hand the message to the visitor's email app
            document.getElementById('contact-form').addEventListener('submit', function (e) {
                e.preventDefault();
                const data = new FormData(this);
                const body = data.get('message') + '\n\n' + data.get('name') + '\n' + data.get('email');
                window.location.href = 'mailto:studioafair@gmail.com'
                    + '?subject=' + encodeURIComponent(data.get('subject'))
                    + '&body=' + encodeURIComponent(body);
            });
        </script>

        <%- include('partials/footer') %>
