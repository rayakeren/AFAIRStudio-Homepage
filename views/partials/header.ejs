<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <% const siteUrl='https://www.a-fair.com' ; %>
  <% const fullTitle=(typeof pageTitle !=='undefined' ? pageTitle + ' | ' : '' ) + 'A FAIR Studio' ; %>
  <% const description=typeof pageDescription !=='undefined' ? pageDescription
    : 'A FAIR Studio - An indie game studio from Surabaya, Indonesia. Creating balanced, engaging gaming experiences.' ; %>
  <% const shareImage=siteUrl + (typeof pageImage !=='undefined' && pageImage ? pageImage : '/images/afair-studio-logo-main.png' ); %>
  <title><%= fullTitle %></title>
  <meta name="description" content="<%= description %>">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="A FAIR Studio">
  <meta property="og:title" content="<%= fullTitle %>">
  <meta property="og:description" content="<%= description %>">
  <meta property="og:image" content="<%= shareImage %>">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="192x192" href="/favicon.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="stylesheet" href="/css/output.css">
</head>

<body class="min-h-screen flex flex-col">
  <!-- Navigation -->
  <nav id="main-nav" class="fixed top-0 left-0 right-0 z-50 bg-black/95 backdrop-blur-sm border-b border-gray-800">
    <div class="container mx-auto px-4 py-4">
      <div class="flex items-center justify-between">
        <!-- Logo -->
        <a href="/" class="group">
          <img src="/images/afair-studio-logo-white.png" alt="A FAIR Studio Logo"
            class="h-10 md:h-12 transition-transform group-hover:scale-105">
        </a>

        <!-- Desktop Navigation -->
        <div class="hidden md:flex items-center space-x-8">
          <a href="/"
            class="text-gray-400 hover:text-brand-gold transition-colors duration-300 font-semibold uppercase text-sm tracking-wider">Home</a>
          <a href="/about"
            class="text-gray-400 hover:text-brand-gold transition-colors duration-300 font-semibold uppercase text-sm tracking-wider">About</a>
          <a href="/games"
            class="text-gray-400 hover:text-brand-gold transition-colors duration-300 font-semibold uppercase text-sm tracking-wider">Games</a>

          <!-- More Dropdown -->
          <div class="relative group">
            <button
              class="text-gray-400 hover:text-white transition-colors duration-300 font-semibold uppercase text-sm tracking-wider flex items-center">
              More
              <%- getIcon('arrow-down', 'w-4 h-4 ml-1' ) %>
            </button>
            <div
              class="absolute left-0 mt-2 w-48 bg-gray-900 border border-gray-800 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-300">
              <a href="/privacy"
                class="block px-4 py-3 text-gray-400 hover:text-white hover:bg-gray-800 transition-colors text-sm">Privacy
                Policy</a>
              <a href="/tos"
                class="block px-4 py-3 text-gray-400 hover:text-white hover:bg-gray-800 transition-colors text-sm">Terms
                of Service</a>
            </div>
          </div>

          <a href="/contact"
            class="bg-brand-purple hover:bg-brand-gold hover:text-black text-white px-6 py-2 transition-all duration-300 font-bold uppercase text-sm tracking-wider border-2 border-brand-purple hover:border-brand-gold">Contact</a>
        </div>

        <!-- Mobile Menu Button -->
        <button id="mobile-menu-btn" class="md:hidden text-white text-2xl" aria-label="Toggle menu"
          aria-expanded="false" aria-controls="mobile-menu">☰</button>
      </div>

      <!-- Mobile Navigation -->
      <div id="mobile-menu" class="hidden md:hidden mt-4 pb-4 space-y-3 border-t border-gray-800 pt-4">
        <a href="/"
          class="block text-gray-400 hover:text-white transition-colors duration-300 font-semibold uppercase text-sm tracking-wider">Home</a>
        <a href="/about"
          class="block text-gray-400 hover:text-white transition-colors duration-300 font-semibold uppercase text-sm tracking-wider">About</a>
        <a href="/games"
          class="block text-gray-400 hover:text-white transition-colors duration-300 font-semibold uppercase text-sm tracking-wider">Games</a>
        <a href="/contact"
          class="block text-gray-400 hover:text-white transition-colors duration-300 font-semibold uppercase text-sm tracking-wider">Contact</a>
        <a href="/privacy"
          class="block text-gray-400 hover:text-white transition-colors duration-300 font-semibold uppercase text-sm tracking-wider">Privacy
          Policy</a>
        <a href="/tos"
          class="block text-gray-400 hover:text-white transition-colors duration-300 font-semibold uppercase text-sm tracking-wider">Terms
          of Service</a>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <main class="flex-grow pt-20">