<%- include('partials/header', { pageTitle: 'About Us' }) %>

        <!-- About Header -->
        <section class="pt-12 md:pt-16 pb-8 bg-black">
            <div class="container mx-auto px-4">
                <div class="max-w-6xl mx-auto">
                    <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">About us</h1>
                    <p class="text-lg text-gray-300 leading-relaxed max-w-3xl">
                        A FAIR Studio is an indie team from Surabaya, Indonesia, born from a college project. Our name
                        is an acronym of our five members, and our logo, the scale, is our guide. We simply love making
                        balanced and engaging games together.
                    </p>
                </div>
            </div>
        </section>

        <!-- Team Members -->
        <section class="py-12 md:py-16 bg-black">
            <div class="container mx-auto px-4">
                <div class="max-w-6xl mx-auto">
                    <h2 class="text-2xl md:text-3xl font-bold text-white mb-8">The team</h2>
                    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-x-6 gap-y-10">
                        <% teamMembers.forEach(member=> { %>
                            <div>
                                <img src="<%= member.image %>" alt="<%= member.name %>" loading="lazy"
                                    class="w-full aspect-square object-cover bg-gray-900 mb-4">
                                <h3 class="font-bold text-white leading-snug mb-1">
                                    <%= member.name %>
                                </h3>
                                <p class="text-sm text-gray-400 mb-3">
                                    <%= member.role %>
                                </p>
                                <div class="flex space-x-3">
                                    <a href="<%= member.instagram %>" target="_blank" rel="noopener"
                                        aria-label="<%= member.name %> on Instagram"
                                        class="text-gray-500 hover:text-brand-gold transition-colors">
                                        <%- getIcon('instagram', 'w-5 h-5' ) %>
                                    </a>
                                    <a href="<%= member.linkedin %>" target="_blank" rel="noopener"
                                        aria-label="<%= member.name %> on LinkedIn"
                                        class="text-gray-500 hover:text-brand-gold transition-colors">
                                        <%- getIcon('linkedin', 'w-5 h-5' ) %>
                                    </a>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>
            </div>
        </section>

        <!-- Awards -->
        <% if (awards.length> 0) { %>
            <section class="pt-12 md:pt-16 pb-20 md:pb-24 bg-black">
                <div class="container mx-auto px-4">
                    <div class="max-w-6xl mx-auto">
                        <h2 class="text-2xl md:text-3xl font-bold text-white mb-8">Awards</h2>
                        <div class="flex flex-wrap justify-center md:justify-between gap-8">
                            <% awards.forEach(award=> { %>
                                <a href="/games/<%= award.game %>" class="flex flex-col items-center group">
                                    <%- include('partials/award-badge', { award }) %>
                                    <span
                                        class="mt-2 text-sm text-gray-400 group-hover:text-brand-gold transition-colors">
                                        <%= award.gameTitle %>
                                    </span>
                                </a>
                            <% }); %>
                        </div>
                    </div>
                </div>
            </section>
        <% } %>

        <%- include('partials/footer') %>
